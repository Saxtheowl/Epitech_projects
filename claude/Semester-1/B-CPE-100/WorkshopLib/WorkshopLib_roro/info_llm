=== COMMANDES DE COMPILATION ET TESTS ===

# Compilation de la bibliothèque
make                    # Compile libmy.a
make clean              # Nettoie les fichiers objets
make fclean             # Nettoie tout (objets + bibliothèque)
make re                 # Recompile tout

# Tests
make tests_run          # Compile et exécute tous les tests unitaires
make test               # Alternative pour les tests

# Utilisation de la bibliothèque
gcc -I./include mon_programme.c -Llib/my -lmy -o mon_programme

# Vérification du contenu de la bibliothèque
nm lib/my/libmy.a       # Liste les symboles dans la bibliothèque
ar -t lib/my/libmy.a    # Liste les fichiers dans l'archive

