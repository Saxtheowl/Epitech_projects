    "passport-jwt": "^4.0.1",
    "sequelize": "^6.32.1",
    "pg": "^8.11.0",
    "pg-hstore": "^2.3.4",
    "sqlite3": "^5.1.6",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^6.7.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
