#!/bin/sh
set -eu
DIR="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BIN="$DIR/eval_expr"

pass=0
fail=0

run() {
  out=$($BIN "$1")
  if [ "$out" = "$2" ]; then
    pass=$((pass + 1))
    printf '%s\n' "[OK ] $1"
  else
    fail=$((fail + 1))
    printf '%s\n' "[KO ] $1 -> got $out"
  fi
}

make -C "$DIR" >/dev/null

run "(3+2)*5" 25
run "2+2" 4
run "10-3-2" 5
run "18/3/3" 2
run "5*3%4" 3
run "40 + (2*5) - 7" 43
run "-3+10" 7
run "-(2-5)" 3
run "--++10" 10
run "(1+(2*(3+(4*(5-6)))))" -1
run "  12 * ( -3 + 5 )" 24

printf '%s\n' '-----'
printf 'Passed: %d  Failed: %d\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
