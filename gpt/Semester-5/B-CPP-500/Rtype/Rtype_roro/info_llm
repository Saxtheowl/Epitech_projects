Tests simples:
- cd B-CPP-500/Rtype/Rtype_roro
- make re
  Attendu: compilation OK (binaires ./r-type_server et ./r-type_client créés)
- ./r-type_server -h; echo $?
  Attendu: affiche USAGE et code 0
- ./r-type_client -h; echo $?
  Attendu: affiche USAGE et code 0
- (./r-type_server 12345 &); sleep 0.2; ./r-type_client 127.0.0.1 12345 hello
  Attendu: affiche "hello"
- (./r-type_server 12346 &); sleep 0.2; ./r-type_client 127.0.0.1 12346 PING
  Attendu: affiche "PONG"
- (./r-type_server 12347 &); sleep 0.2; ./r-type_client 127.0.0.1 12347 "JOIN bob"
  Attendu: affiche "JOINED 1"
- (./r-type_server 12349 &); sleep 0.2; id=$(./r-type_client 127.0.0.1 12349 "JOIN a"|awk '{print $2}'); \
  ./r-type_client 127.0.0.1 12349 "STATE ${id}?"; \
  ./r-type_client 127.0.0.1 12349 "MOVE ${id} 1 0"; sleep 1.2; \
  ./r-type_client 127.0.0.1 12349 "STATE ${id}?"
  Attendu: affiche d’abord "STATE 0 0", puis "OK", puis "STATE 1 0"
- (./r-type_server 12348 &); sleep 0.2; ./r-type_client 127.0.0.1 12348 QUIT
  Attendu: affiche "QUIT" et le serveur se termine
- make tests_run
  Attendu: Criterion affiche "Passing: 1"
