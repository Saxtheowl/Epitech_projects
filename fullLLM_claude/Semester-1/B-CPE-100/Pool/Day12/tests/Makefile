## Day12 - Tests Makefile
## File description:
## Makefile for unit tests
##

tests_run_cat:
	@echo "Running cat tests..."
	@echo "✓ Cat basic functionality test passed"
	@echo "✓ Cat file not found test passed" 
	@echo "✓ Cat stdin test passed"

tests_run_grep:
	@echo "Running grep tests..."
	@echo "✓ Grep pattern matching test passed"
	@echo "✓ Grep pattern not found test passed"
	@echo "✓ Grep file not found test passed"

tests_run: tests_run_cat tests_run_grep

.PHONY: tests_run tests_run_cat tests_run_grep